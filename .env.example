# ==================== LLM (requerido) ====================
# Proveedor: openai (default) | azure | ollama
# LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.7
MOODLE_URL=https://abc.com/                                                                                       
MOODLE_USERNAME=                                                                                                            
MOODLE_PASSWORD=  
# Azure OpenAI (solo si LLM_PROVIDER=azure)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-02-01

# Ollama local (solo si LLM_PROVIDER=ollama, sin API key)
# OLLAMA_MODEL=llama3

# ==================== LANGSMITH OBSERVABILIDAD (opcional) ====================
# Activa trazabilidad de todos los agentes y herramientas en https://smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__your-langsmith-key
# LANGCHAIN_PROJECT=multi-agents

# ==================== HITL (opcional) ====================
# Pide confirmación al usuario antes de ejecutar code_agent y web_scraping_agent
# Poner false en entornos batch o tests
# HITL_ENABLED=true

# ==================== PERSISTENCIA DE SESIONES ====================
# SQLite (default) — sessions/sessions.db, con migración one-shot desde JSONL
# Poner false para volver al backend JSONL original (sessions/{session_id}.jsonl)
# USE_SQLITE=true

# ==================== AGENTDOG GUARDRAIL (opcional) ====================
# URL del juez/guard (API OpenAI-compatible, ej. llama-server).
# Con docker compose up (juez en otro contenedor): usar host.docker.internal
# Con python main.py en el host: usar localhost
AGENTDOG_GUARD_URL=http://host.docker.internal:8080/v1/chat/completions
# AGENTDOG_API_KEY=
# AGENTDOG_POLICY=fail_open
# AGENTDOG_EVAL_MODE=high_risk_only
# AGENTDOG_AUDIT_LOG=./logs/agentdog_audit.jsonl

# ==================== GOOGLE CALENDAR MCP (opcional) ====================
# Si querés que Codex cree eventos en Google Calendar desde cualquier proyecto,
# guardá esto en ~/.codex/google-calendar.env o en un .env local.
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your-google-refresh-token
# GOOGLE_CALENDAR_ID=primary

# ==================== NOTION TASK SYNC (opcional) ====================
# Database de Notion para upsert interno de tareas Moodle.
#NOTION_API_KEY=secret_xxxxx
#NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#NOTION_API_VERSION=2022-06-28
# LinkedIn Jobs read-only (sesión creada manualmente con scripts/bootstrap_linkedin_session.py)
LINKEDIN_STORAGE_STATE_PATH=data/private/linkedin/default/storage_state.json
# Perfil Playwright persistente DEDICADO. Debe permanecer dentro del mismo
# directorio privado de LinkedIn; nunca uses Default/Profile * de Chrome/Brave.
# Vacío = data/private/linkedin/default/browser-profile.
LINKEDIN_PROFILE_DIR=
LINKEDIN_MAX_RESULTS=50
LINKEDIN_DETAIL_BUDGET=25
LINKEDIN_DETAIL_CLICK_INTERVAL_MS=1200
LINKEDIN_DIRECT_DETAIL_FALLBACK=false
LINKEDIN_MAX_QUERIES_PER_LOCATION=2
LINKEDIN_QUERY_INTERVAL_MS=2750
LINKEDIN_LOCATION=
# Precedencia runtime: variables LINKEDIN_BROWSER/EXECUTABLE no vacías >
# metadata privada guardada por bootstrap > Chromium bundled. Dejá estos valores
# vacíos para reutilizar automáticamente el navegador del bootstrap.
# Valores: chromium, chrome, edge/msedge, brave o executable.
LINKEDIN_BROWSER=
# Requerido para brave/executable. Debe ser una ruta absoluta a un binario dedicado.
# Nunca apuntes al directorio de perfil personal del navegador.
LINKEDIN_BROWSER_EXECUTABLE_PATH=
# false es el default local y mantiene paridad con el bootstrap visible.
# Usá true sólo si verificaste que tu sesión funciona en headless.
LINKEDIN_HEADLESS=false
LINKEDIN_HTML_DIAGNOSTICS=false
